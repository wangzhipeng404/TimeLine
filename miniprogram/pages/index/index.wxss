/* pages/index/index.wxss */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.settings-btn {
  background: none;
  border: none;
  font-size: 40rpx;
  padding: 0;
  line-height: 1;
}

.offline-toast {
  background-color: #ff9800;
  color: white;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.collection-list {
  padding: 20rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.collection-card {
  background-color: white;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  position: relative;
}

.card-cover {
  width: 100%;
  height: 0;
  padding-bottom: 100%;
  position: relative;
  flex-shrink: 0;
}

.cover-image,
.cover-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  background-color: #e0e0e0;
}

.card-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  padding: 12rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-meta {
  font-size: 22rpx;
  color: #999;
  padding: 0 12rpx 12rpx;
  text-align: center;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #4CAF50;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.4);
}

/* 弹窗样式 */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.dialog {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  width: 600rpx;
}

.dialog-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
}

.dialog-input {
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  margin-bottom: 30rpx;
}

.dialog-actions {
  display: flex;
  justify-content: space-between;
}

.dialog-btn-cancel,
.dialog-btn-confirm {
  flex: 1;
  padding: 20rpx;
  border: none;
  font-size: 28rpx;
  border-radius: 8rpx;
}

.dialog-btn-cancel {
  background-color: #f5f5f5;
  margin-right: 15rpx;
}

.dialog-btn-confirm {
  background-color: #4CAF50;
  color: white;
  margin-left: 15rpx;
}

/* 操作菜单 */
.action-menu {
  background-color: white;
  border-radius: 16rpx;
  padding: 20rpx 0;
  width: 600rpx;
}

.action-item {
  padding: 30rpx 30rpx;
  text-align: center;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.action-item:last-child {
  border-bottom: none;
}

.action-item.danger {
  color: #f44336;
}

.action-item.cancel {
  color: #999;
  margin-top: 10rpx;
}

.collection-card.add-card {
  background-color: #f5f5f5;
  border: 2rpx dashed #ccc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.collection-card.add-card .cover-placeholder {
  background-color: transparent;
  font-size: 100rpx;
  color: #999;
}

.collection-card.add-card .card-name {
  color: #999;
  margin-top: 10rpx;
}

/* 添加卡片按钮 */
.add-card-btn {
  background-color: #4CAF50;
  color: white;
  text-align: center;
  padding: 16rpx;
  font-size: 24rpx;
  font-weight: bold;
  margin: 0 12rpx 12rpx;
  border-radius: 8rpx;
}
