/* pages/collection/collection.wxss */

.container {
  padding: 0;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(to bottom, rgba(0,0,0,0.8), transparent);
}

.header-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.collection-name {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

.record-count {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}

.icon-btn {
  background-color: #4CAF50;
  color: white;
  border: none;
  border-radius: 8rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

.fullscreen-swiper {
  height: 100vh;
  width: 100%;
}

.slide {
  width: 100%;
  height: 100%;
  position: relative;
  background-color: #000;
  display: flex;
  align-items: center;
}

.slide-image {
  width: 100%;
  display: block;
  max-height: 100%;
  object-fit: contain;
}

.slide-info {
  padding: 30rpx;
  background-color: rgba(0,0,0,0.4);
  position: absolute;
  bottom: 60rpx;
  left: 0;
  right: 0;
  z-index: 10;
}

.slide-date {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 8rpx;
}

.slide-note {
  display: block;
  font-size: 32rpx;
  color: rgba(255,255,255,0.95);
  line-height: 1.4;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
}

.fab-btn {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #fff;
  border: 6rpx solid #4CAF50;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.camera-icon {
  width: 70rpx;
  height: 70rpx;
}
